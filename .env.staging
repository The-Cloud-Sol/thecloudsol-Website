# Staging Environment Variables
NODE_ENV=staging

# Application Configuration
VITE_APP_NAME=The Cloud Sol (Staging)
VITE_APP_URL=https://staging.thecloudsol.com
VITE_APP_DESCRIPTION=Professional cloud solutions provider - Staging Environment

# API Configuration
VITE_API_URL=https://staging-api.thecloudsol.com
VITE_API_TIMEOUT=10000

# Analytics and Monitoring (Disabled in staging)
VITE_GA_ID=
VITE_HOTJAR_ID=
VITE_SENTRY_DSN=

# Contact Information
VITE_CONTACT_EMAIL=staging@thecloudsol.com
VITE_CONTACT_PHONE=+1234567890

# Social Media Links
VITE_FACEBOOK_URL=https://facebook.com/thecloudsol
VITE_LINKEDIN_URL=https://linkedin.com/company/thecloudsol
VITE_TWITTER_URL=https://twitter.com/thecloudsol

# Performance and Optimization
VITE_ENABLE_SERVICE_WORKER=false
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_ERROR_REPORTING=true

# CDN Configuration
VITE_CDN_URL=https://staging-cdn.thecloudsol.com
VITE_ASSETS_URL=https://staging-assets.thecloudsol.com

# Security
VITE_RECAPTCHA_SITE_KEY=staging-recaptcha-site-key
