# Production Environment Variables
NODE_ENV=production

# Application Configuration
VITE_APP_NAME=The Cloud Sol
VITE_APP_URL=https://thecloudsol.com
VITE_APP_DESCRIPTION=Professional cloud solutions provider offering Microsoft 365, Azure, AWS, Google Workspace, and custom cloud services

# API Configuration
VITE_API_URL=https://api.thecloudsol.com
VITE_API_TIMEOUT=10000

# Analytics and Monitoring
VITE_GA_ID=G-XXXXXXXXXX
VITE_HOTJAR_ID=123456
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Contact Information
VITE_CONTACT_EMAIL=info@thecloudsol.com
VITE_CONTACT_PHONE=+1234567890

# Social Media Links
VITE_FACEBOOK_URL=https://facebook.com/thecloudsol
VITE_LINKEDIN_URL=https://linkedin.com/company/thecloudsol
VITE_TWITTER_URL=https://twitter.com/thecloudsol

# Performance and Optimization
VITE_ENABLE_SERVICE_WORKER=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_REPORTING=true

# CDN Configuration
VITE_CDN_URL=https://cdn.thecloudsol.com
VITE_ASSETS_URL=https://assets.thecloudsol.com

# Security
VITE_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
